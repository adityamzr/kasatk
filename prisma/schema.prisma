generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  COMPLETED
  CANCELLED
}

enum SavingsType {
  DEPOSIT
  WITHDRAWAL
  DEPOSIT_CORRECTION
  WITHDRAWAL_CORRECTION
}

enum SavingsStatus {
  COMPLETED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model SchoolSetting {
  id               Int      @id @default(1)
  schoolName       String   @default("PAUD Cerdas Ceria")
  schoolAddress    String?
  schoolPhone      String?
  schoolEmail      String?
  logoUrl          String?
  receiptPrefix    String   @default("KW")
  receiptSequence  Int      @default(0)
  defaultSppAmount Decimal? @db.Decimal(14, 2)
  timezone         String   @default("Asia/Jakarta")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  username     String?    @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        UserRole[]
  billsCreated Bill[]
  payments     Payment[]
  savings      SavingsTransaction[]
  auditLogs    AuditLog[]
  receipts     Receipt[]
  authSessions AuthSession[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ClassRoom {
  id           String   @id @default(cuid())
  name         String
  level        String?
  academicYear String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students Student[]
  bills    Bill[]

  @@unique([name, academicYear])
  @@index([isActive])
}

model Parent {
  id          String    @id @default(cuid())
  name        String
  phone       String    @unique
  email       String?
  address     String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students StudentParent[]
  sessions ParentSession[]

  @@index([name])
}

model Student {
  id              String        @id @default(cuid())
  nis             String        @unique
  name            String
  dateOfBirth     DateTime
  gender          String?
  status          StudentStatus @default(ACTIVE)
  classRoomId     String
  notes           String?
  customSppAmount Decimal?      @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  classRoom ClassRoom            @relation(fields: [classRoomId], references: [id])
  parents   StudentParent[]
  bills     Bill[]
  payments  Payment[]
  savings   SavingsTransaction[]

  @@index([name])
  @@index([classRoomId, status])
}

model StudentParent {
  studentId String
  parentId  String
  isPrimary Boolean @default(false)
  relation  String?
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
}

model Bill {
  id             String     @id @default(cuid())
  studentId      String
  classRoomId    String?
  createdById    String
  code           String     @unique
  title          String
  description    String?
  periodLabel    String?
  billingMonth   Int?
  billingYear    Int?
  originalAmount Decimal?   @db.Decimal(14, 2)
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime?
  amount         Decimal    @db.Decimal(14, 2)
  status         BillStatus @default(UNPAID)
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  student     Student             @relation(fields: [studentId], references: [id])
  classRoom   ClassRoom?          @relation(fields: [classRoomId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@unique([studentId, billingMonth, billingYear])
  @@index([studentId, status])
  @@index([periodStart, periodEnd])
}

model Payment {
  id            String        @id @default(cuid())
  studentId     String
  recordedById  String
  paymentNumber String        @unique
  paymentDate   DateTime      @default(now())
  method        PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  notes         String?
  status        PaymentStatus @default(COMPLETED)
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student       Student             @relation(fields: [studentId], references: [id])
  recordedBy    User                @relation(fields: [recordedById], references: [id])
  allocations   PaymentAllocation[]
  receipt       Receipt?
  notifications NotificationLog[]

  @@index([studentId, paymentDate])
  @@index([status, paymentDate])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal @db.Decimal(14, 2)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill      Bill    @relation(fields: [billId], references: [id])

  @@unique([paymentId, billId])
  @@index([billId])
}

model SavingsTransaction {
  id                String        @id @default(cuid())
  studentId         String
  recordedById      String
  transactionNumber String        @unique
  type              SavingsType
  transactionDate   DateTime      @default(now())
  amount            Decimal       @db.Decimal(14, 2)
  balanceAfter      Decimal       @db.Decimal(14, 2)
  notes             String?
  status            SavingsStatus @default(COMPLETED)
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  student       Student           @relation(fields: [studentId], references: [id])
  recordedBy    User              @relation(fields: [recordedById], references: [id])
  notifications NotificationLog[]
  receipt       Receipt?

  @@index([studentId, transactionDate])
  @@index([status, transactionDate])
}

model Receipt {
  id            String              @id @default(cuid())
  receiptNumber String              @unique
  paymentId     String?             @unique
  savingsId     String?             @unique
  issuedById    String
  issuedAt      DateTime            @default(now())
  pdfUrl        String?
  payment       Payment?            @relation(fields: [paymentId], references: [id])
  savings       SavingsTransaction? @relation(fields: [savingsId], references: [id])
  issuedBy      User                @relation(fields: [issuedById], references: [id])

  @@index([issuedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model NotificationLog {
  id                String              @id @default(cuid())
  channel           String              @default("WHATSAPP")
  recipient         String
  messageType       String
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  paymentId         String?
  savingsId         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  savings           SavingsTransaction? @relation(fields: [savingsId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ParentSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  parentId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, expiresAt])
}
